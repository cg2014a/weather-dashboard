{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skystation-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "NOTIFICATIONS_DB",
      "database_name": "skystation-notifications",
      "database_id": "21d9ef0b-a904-46dc-98c4-6289f887b70c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
